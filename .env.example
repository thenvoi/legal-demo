# ─── Default setup (needs an OpenAI API key) ────────────────────────────
#
# The shipped scenarios run a mix of langgraph and pydantic_ai agents
# on OpenAI models (gpt-5.4 / gpt-5.4-mini), so the default path needs
# OPENAI_API_KEY set below.

OPENAI_API_KEY=

# ─── Alternatives (no OpenAI API key required) ──────────────────────────
#
# Every agent is framework-agnostic. If you don't have an OpenAI key,
# edit scenarios/<name>/agents.yaml and switch any agent's `framework:`
# to one of the options below. See the README "Swap a framework"
# section for the full walk-through; the agents.yaml files also have
# the alternatives listed at the top as copy-pasteable examples.
#
#   framework: codex          # uses your Codex CLI subscription — run `codex login` once
#   framework: claude_sdk     # uses your Claude subscription via `claude login`
#   framework: langgraph      # point langgraph at a local model via an OpenAI-compatible
#                             # endpoint (Ollama, vLLM, LM Studio); set the two variables
#                             # below to your local server URL + any placeholder API key
#
# OPENAI_BASE_URL=http://localhost:11434/v1
# (also set OPENAI_API_KEY=ollama or any dummy value when using a local endpoint)

# ─── Optional ────────────────────────────────────────────────────────────
#
# The recommended setup creates agents and rooms through the Thenvoi web
# UI (app.thenvoi.com), which needs no API key here. Fill in
# THENVOI_API_KEY_USER only if you plan to use the optional automation
# scripts (setup_agents.py for bulk agent registration, or kickoff.py for
# automatic room creation). You can get a User API key from your account
# settings at app.thenvoi.com.

THENVOI_API_KEY_USER=

# ANTHROPIC_API_KEY is only needed if you switch an agent to the bare
# `anthropic` adapter (not claude_sdk, which uses your Claude subscription).
# ANTHROPIC_API_KEY=
