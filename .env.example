# Copy to .env and fill in. Do NOT commit .env (it is git-ignored).

# User API key from platform.thenvoi.com (account settings).
# Used by setup_agents.py to register agents and by kickoff.py for room setup.
BAND_API_KEY_USER=

# Optional per-team User API keys. When set, each team's agents are registered
# under its own account, so team-strategy memories stay isolated between teams.
# Leave unset to register every team under BAND_API_KEY_USER (no isolation).
BAND_API_KEY_USER_STARTUP=
BAND_API_KEY_USER_VC=

# Optional: enable the platform Memory API (Enterprise plan only). When unset, agents
# run without memory — no team-strategy seeding, no memory tools, no deal-state tracking.
# Set to 1 only on an Enterprise account, otherwise memory calls return 403.
# BAND_ENABLE_MEMORY=1

# Model provider keys, per the framework/model chosen in each scenario's agents.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: only needed if an agent in agents.yaml uses framework: letta.
# LETTA_API_KEY=

# Optional: set to 1 to enable DEBUG logging for band + httpx/openai in run_all.py.
# BAND_DEBUG=1
