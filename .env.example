# .env is optional for the hackathon demo.
#
# The recommended setup flow creates agents and rooms through the
# Thenvoi web UI (app.thenvoi.com), which needs no API key here.
#
# Fill in THENVOI_API_KEY_USER only if you plan to use the optional
# automation scripts (setup_agents.py to bulk-register agents, or
# kickoff.py to auto-create the negotiation room). You can get a User
# API key from your account settings at app.thenvoi.com.

THENVOI_API_KEY_USER=

# You do not need OPENAI_API_KEY or ANTHROPIC_API_KEY for the default
# (codex) setup. Codex handles OpenAI auth through `codex login`.
# Uncomment only if you switch agents to a framework that reads these
# directly (anthropic, pydantic_ai without codex, langgraph, etc.).
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
